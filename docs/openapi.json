 "components": {
  "schemas": {
   "CommandIn": {
    "properties": {
     "spacecraft_id": {
      "type": "string",
      "format": "uuid",
      "title": "Spacecraft Id"
     },
     "command_type": {
      "type": "string",
      "enum": [
       "payload_delay",
       "maneuver"
      ],
      "title": "Command Type"
     },
     "args": {
      "additionalProperties": true,
      "type": "object",
      "title": "Args",
      "description": "payload_delay: {start_min, end_min, delay_min}; maneuver: {delta_v_mps, conjunction_id}"
     },
     "scheduled_for": {
      "type": "string",
      "format": "date-time",
      "title": "Scheduled For"
     }
    },
    "type": "object",
    "required": [
     "spacecraft_id",
     "command_type",
     "args",
     "scheduled_for"
    ],
    "title": "CommandIn"
   },
   "ConjunctionIn": {
    "properties": {
     "spacecraft_id": {
      "type": "string",
      "format": "uuid",
      "title": "Spacecraft Id"
     },
     "object_id": {
      "type": "string",
      "maxLength": 40,
      "title": "Object Id"
     },
     "tca": {
      "type": "string",
      "format": "date-time",
      "title": "Tca"
     },
     "miss_distance_m": {
      "type": "number",
      "maximum": 50000.0,
      "exclusiveMinimum": 0.0,
      "title": "Miss Distance M"
     },
     "sigma_m": {
      "type": "number",
      "maximum": 5000.0,
      "exclusiveMinimum": 0.0,
      "title": "Sigma M",
      "description": "Combined position uncertainty at closest approach, one standard deviation"
     },
     "radius_m": {
      "type": "number",
      "maximum": 50.0,
      "exclusiveMinimum": 0.0,
      "title": "Radius M",
      "description": "Combined hard-body radius",
      "default": 5.0
     }
    },
    "type": "object",
    "required": [
     "spacecraft_id",
     "object_id",
     "tca",
     "miss_distance_m",
     "sigma_m"
    ],
    "title": "ConjunctionIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "LoadIn": {
    "properties": {
     "seed": {
      "type": "integer",
      "maximum": 1000000.0,
      "minimum": 0.0,
      "title": "Seed",
      "default": 17
     }
    },
    "type": "object",
    "title": "LoadIn"
   },
   "ManeuverIn": {
    "properties": {
     "conjunction_id": {
      "type": "string",
      "format": "uuid",
      "title": "Conjunction Id"
     },
     "delta_v_mps": {
      "type": "number",
      "maximum": 2.0,
      "exclusiveMinimum": 0.0,
      "title": "Delta V Mps",
      "default": 0.05
     },
     "burn_at": {
      "type": "string",
      "format": "date-time",
      "title": "Burn At"
     },
     "delay_payload_min": {
      "type": "integer",
      "maximum": 1440.0,
      "minimum": 0.0,
      "title": "Delay Payload Min",
      "description": "Move the payload campaign that overlaps the burn window this many minutes later",
      "default": 0
     }
    },
    "type": "object",
    "required": [
     "conjunction_id",
     "burn_at"
    ],
    "title": "ManeuverIn"
   },
   "Packet": {
    "properties": {
     "ts": {
      "type": "string",
      "format": "date-time",
      "title": "Ts"
     },
     "subsystem": {
      "type": "string",
      "maxLength": 16,
      "title": "Subsystem"
     },
     "metric": {
      "type": "string",
      "enum": [
       "battery_voltage_v",
       "battery_temp_c",
       "soc",
       "solar_current_a",
       "bus_current_a",
       "panel_temp_c",
       "obc_temp_c",
       "wheel_speed_rpm"
      ],
      "title": "Metric"
     },
     "value": {
      "type": "number",
      "title": "Value"
     },
     "unit": {
      "type": "string",
      "maxLength": 8,
      "title": "Unit"
     }
    },
    "type": "object",
    "required": [
     "ts",
     "subsystem",
     "metric",
     "value",
     "unit"
    ],
    "title": "Packet"
   },
   "PacketsIn": {
    "properties": {
     "spacecraft_id": {
      "type": "string",
      "format": "uuid",
      "title": "Spacecraft Id"
     },
     "packets": {
      "items": {
       "$ref": "#/components/schemas/Packet"
      },
      "type": "array",
      "maxItems": 5000,
      "minItems": 1,
      "title": "Packets"
     }
    },
    "type": "object",
    "required": [
     "spacecraft_id",
     "packets"
    ],
    "title": "PacketsIn"
   },
   "PlanIn": {
    "properties": {
     "horizon_h": {
      "type": "integer",
      "maximum": 30.0,
      "minimum": 2.0,
      "title": "Horizon H",
      "default": 24
     }
    },
    "type": "object",
    "title": "PlanIn"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
