  {
   "title": "Too many requests for the passes",
   "say": "Twelve spacecraft want to downlink more than the next 24 hours of passes can carry, with priorities and deadlines, and the sun-synchronous ones all reach Svalbard at the same time. The planner chooses passes so that the most important data lands first; the obvious first-come schedule is shown beside it.",
   "calls": [
    {
     "key": "plan",
     "as": "operator",
     "method": "POST",
     "path": "/v1/planning/contacts",
     "body": {
      "horizon_h": 24
     }
    }
   ]
  },
  {
   "title": "A conjunction alert",
   "say": "A screening message: debris will pass 180 metres from RBO-03 in 20 hours, with 120 metres of uncertainty. The chance of collision is scored and it is above the action threshold.",
   "calls": [
    {
     "key": "cdm",
     "as": "operator",
     "method": "POST",
     "path": "/v1/conjunctions",
     "body": {
      "spacecraft_id": "3a6b05a4-6b0f-5966-8a05-d1da55451cce",
      "object_id": "DEBRIS 2019-006AJ",
      "tca": "2026-10-06T14:00:00Z",
      "miss_distance_m": 180.0,
      "sigma_m": 120.0,
      "radius_m": 5
     }
    },
    {
     "key": "list",
     "as": "viewer",
     "method": "GET",
     "path": "/v1/conjunctions?risk_min=0.00001"
    }
   ]
  },
  {
   "title": "Would a manoeuvre be safe to fly?",
   "say": "A 5 cm/s burn five hours before closest approach moves the spacecraft kilometres along its orbit, and the probability falls to nothing. But the battery: a 72-minute imaging campaign sits just before the burn, and the forecast says the state of charge at ignition would be below the 80% rule. With the campaign moved past the approach, it is not.",
   "calls": [
    {
     "key": "sim",
     "as": "operator",
     "method": "POST",
     "path": "/v1/scenarios/orbit-maneuver",
     "body": {
      "conjunction_id": "{{cdm.conjunction_id}}",
      "delta_v_mps": 0.05,
      "burn_at": "2026-10-06T09:00:00Z",
      "delay_payload_min": 420
     }
    }
   ]
  },
  {
   "title": "Two people before anything is sent",
   "say": "The manoeuvre is refused while the payload plan stands: the margin rule is checked at the queue, not by a person remembering. The payload delay is queued, approved by an engineer, then released by the director; the director trying to approve twice is refused, and so is the operator. Then the manoeuvre goes the same way.",
   "calls": [
    {
     "key": "early",
     "as": "operator",
     "method": "POST",
     "path": "/v1/commands",
     "expect_error": true,
     "body": {
      "spacecraft_id": "3a6b05a4-6b0f-5966-8a05-d1da55451cce",
      "command_type": "maneuver",
      "args": {
       "delta_v_mps": 0.05,
       "conjunction_id": "{{cdm.conjunction_id}}"
      },
      "scheduled_for": "2026-10-06T09:00:00Z"
     }
    },
    {
     "key": "c1",
     "as": "operator",
     "method": "POST",
     "path": "/v1/commands",
     "body": {
      "spacecraft_id": "3a6b05a4-6b0f-5966-8a05-d1da55451cce",
      "command_type": "payload_delay",
      "args": {
       "start_min": 1890,
       "end_min": 1962,
       "delay_min": 420
      },
      "scheduled_for": "2026-10-06T06:30:00Z"
     }
    },
    {
     "key": "a1",
     "as": "engineer",
     "method": "POST",
     "path": "/v1/commands/{{c1.command_id}}/approve"
    },
    {
     "key": "twice",
     "as": "engineer",
     "method": "POST",
     "path": "/v1/commands/{{c1.command_id}}/approve",
     "expect_error": true
    },
    {
     "key": "nope",
     "as": "operator",
     "method": "POST",
     "path": "/v1/commands/{{c1.command_id}}/approve",
     "expect_error": true
    },
    {
     "key": "a2",
     "as": "director",
     "method": "POST",
     "path": "/v1/commands/{{c1.command_id}}/approve"
    },
    {
     "key": "c2",
     "as": "operator",
     "method": "POST",
     "path": "/v1/commands",
     "body": {
      "spacecraft_id": "3a6b05a4-6b0f-5966-8a05-d1da55451cce",
      "command_type": "maneuver",
      "args": {
       "delta_v_mps": 0.05,
       "conjunction_id": "{{cdm.conjunction_id}}"
      },
